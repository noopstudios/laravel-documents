{
    "name": "noopstudios/laravel-documents",
    "description": "PDF generation (Gotenberg) and Word templates (word2pdf) for Laravel.",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "ext-zip": "*",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Noop\\Documents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noop\\Documents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noop\\Documents\\DocumentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
